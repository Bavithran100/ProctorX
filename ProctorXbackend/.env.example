PORT=9080

# Database Configuration
DATABASE_URL=jdbc:mysql://<host>:<port>/<dbname>?ssl-mode=REQUIRED
DB_USERNAME=root
DB_PASSWORD=password

# Google OAuth2 Credentials
GOOGLE_CLIENT=your-google-client-id.apps.googleusercontent.com
GOOGLE_SECRET=your-google-client-secret

# JDoodle Code Execution API
JD_ID=your-jdoodle-client-id
JD_SECRET=your-jdoodle-client-secret

# Groq AI Question Generation
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MCQ_MODEL=openai/gpt-oss-120b
GROQ_CODING_MODEL=openai/gpt-oss-120b

# Email Dispatch Configuration (SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-16-character-app-password
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS=true

# Frontend base URL for email links
FRONTEND_URL=http://localhost:5173
