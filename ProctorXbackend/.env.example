# ==============================================================================
# PROCTORX BACKEND ENVIRONMENT CONFIGURATION (SINGLE SOURCE OF TRUTH)
# ==============================================================================

# Server Port
PORT=9080

# Frontend URL (Used for OAuth redirects, password reset email links, CORS)
# Local: http://localhost:5173
# Production (Vercel): https://your-proctorx-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Comma-separated additional allowed CORS origins (Optional)
CORS_ALLOWED_ORIGINS=https://your-custom-domain.com

# Session Cookie Security
# Local: SESSION_SAME_SITE=Lax, SESSION_SECURE=false
# Production (Vercel <-> Render cross-domain): SESSION_SAME_SITE=None, SESSION_SECURE=true
SESSION_SAME_SITE=Lax
SESSION_SECURE=false

# ==============================================================================
# Database Configuration (MySQL / Aiven / Render / AWS RDS)
# ==============================================================================
DATABASE_URL=jdbc:mysql://localhost:3306/proctorx?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=rootpassword

# ==============================================================================
# Google OAuth2 SSO Credentials
# ==============================================================================
GOOGLE_CLIENT=your-google-client-id.apps.googleusercontent.com
GOOGLE_SECRET=your-google-client-secret

# ==============================================================================
# Code Execution Compiler Engines (JDoodle & OneCompiler)
# ==============================================================================
PRIMARY_COMPILER=jdoodle
COMPILER_FALLBACK_ENABLED=true

# JDoodle Engine
JDOODLE_URL=https://api.jdoodle.com/v1/execute
JD_ID=your-jdoodle-client-id
JD_SECRET=your-jdoodle-client-secret

# OneCompiler Engine
ONECOMPILER_URL=https://api.onecompiler.com/v1/run
ONECOMPILER_API_KEY=your-onecompiler-api-key

# ==============================================================================
# AI Question Blueprint Generator (Groq / OpenAI-compatible LLM)
# ==============================================================================
GROQ_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MCQ_MODEL=openai/gpt-oss-120b
GROQ_CODING_MODEL=openai/gpt-oss-120b

# ==============================================================================
# Email Dispatch Configuration (SMTP - Gmail / SendGrid / AWS SES)
# ==============================================================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-institution-email@gmail.com
SPRING_MAIL_PASSWORD=your-16-char-app-password
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS=true
