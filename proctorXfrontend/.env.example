# ==============================================================================
# PROCTORX FRONTEND ENVIRONMENT TEMPLATE
# Copy to .env and customize for local development or set in Vercel Project Settings
# ==============================================================================

# Backend API Base URL (including /api path)
# Local: http://localhost:9080/api
# Production (Render): https://your-backend-service.onrender.com/api
VITE_API_BASE_URL=http://localhost:9080/api

# Frontend URL for Canonical Links and OpenGraph Metadata
# Local: http://localhost:5173
# Production (Vercel): https://your-app-name.vercel.app
VITE_FRONTEND_URL=http://localhost:5173

# Application Metadata
VITE_SITE_NAME=ProctorX
VITE_APP_ENV=production
