# ==============================================================================
# PROCTORX FULL-STACK ENVIRONMENT TEMPLATE (SINGLE SOURCE OF TRUTH)
# ==============================================================================
# Instructions:
# 1. For Local Development: Values below work with local ports 5173 (Frontend), 9080 (Backend), 3306 (MySQL).
# 2. For Docker Compose: Run `docker compose up --build`.
# 3. For Vercel Deployment (Frontend): Set VITE_API_BASE_URL and VITE_FRONTEND_URL in Vercel Settings.
# 4. For Render Deployment (Backend): Set environment variables in Render Dashboard / render.yaml.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vercel / Local Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:9080/api
VITE_FRONTEND_URL=http://localhost:5173
VITE_SITE_NAME=ProctorX
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# 2. BACKEND & SECURITY CONFIGURATION (Render / Spring Boot)
# ------------------------------------------------------------------------------
PORT=9080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=https://proctor-x-frontend.vercel.app

# Cross-Site Cookie Policy
# Local Development: SESSION_SAME_SITE=Lax, SESSION_SECURE=false
# Cloud Production (Vercel <-> Render cross-domain): SESSION_SAME_SITE=None, SESSION_SECURE=true
SESSION_SAME_SITE=Lax
SESSION_SECURE=false

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (MySQL / Aiven Cloud / Docker Compose)
# ------------------------------------------------------------------------------
DATABASE_URL=jdbc:mysql://localhost:3306/proctorx?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=rootpassword
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=proctorx

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH2 SINGLE SIGN-ON
# ------------------------------------------------------------------------------
GOOGLE_CLIENT=your-google-client-id.apps.googleusercontent.com
GOOGLE_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 5. ONLINE CODE COMPILERS (JDoodle & OneCompiler)
# ------------------------------------------------------------------------------
PRIMARY_COMPILER=jdoodle
COMPILER_FALLBACK_ENABLED=true

# JDoodle API
JDOODLE_URL=https://api.jdoodle.com/v1/execute
JD_ID=your-jdoodle-client-id
JD_SECRET=your-jdoodle-client-secret

# OneCompiler API
ONECOMPILER_URL=https://api.onecompiler.com/v1/run
ONECOMPILER_API_KEY=your-onecompiler-api-key

# ------------------------------------------------------------------------------
# 6. AI QUESTION GENERATOR (Groq / OpenAI Compatible)
# ------------------------------------------------------------------------------
GROQ_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MCQ_MODEL=openai/gpt-oss-120b
GROQ_CODING_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 7. EMAIL DISPATCH SERVICE (SMTP - Gmail / SendGrid / AWS SES)
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-institution-email@gmail.com
SPRING_MAIL_PASSWORD=your-16-character-app-password
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS=true
